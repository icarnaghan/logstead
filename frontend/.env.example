# Base URL of the Logstead HTTP API (API Gateway stage URL).
VITE_API_BASE_URL=http://localhost:3000

# Cognito Hosted UI configuration (consumed by the auth flow, task 20.1).
# Domain origin, e.g. https://logstead.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
# App client id registered on the Cognito User Pool.
VITE_COGNITO_CLIENT_ID=
# SPA callback URL registered on the app client, e.g. http://localhost:5173/auth/callback
VITE_COGNITO_REDIRECT_URI=
# Post-logout redirect URL registered on the app client, e.g. http://localhost:5173/
VITE_COGNITO_LOGOUT_URI=
# Optional space-separated OAuth2 scopes. Defaults to "openid email profile".
VITE_COGNITO_SCOPES=openid email profile
